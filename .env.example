# AWS (EC2에서는 IAM Role 사용을 권장 - 그 경우 아래 키는 비워둠)
AWS_REGION=ap-northeast-2

# S3
S3_BUCKET=your-bucket-name
S3_MODEL_KEY=models/latest/model.pkl
# 로컬 캐시 경로
MODEL_LOCAL_PATH=/tmp/model.pkl

# 앱 시작 시 S3에서 모델을 강제로 다시 받을지 여부
FORCE_DOWNLOAD=false

# hugme-postgre
DB_HOST=localhost
DB_PORT=5433
DB_NAME=hugmedb
DB_USER=hugme
DB_PASSWORD=1234
# 악성임대인 수집 결과 저장 장소
BAD_LANDLORD_CSV_PATH=/tmp/hug_defaulters.csv

OPENAI_API_KEY=
REGISTRY_LLM_MODEL=gpt-4.1
